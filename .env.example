# Django
DJANGO_SETTINGS_MODULE=portal.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
WAGTAILADMIN_BASE_URL=http://127.0.0.1:8000

# Superuser created by: python manage.py bootstrap_workshop
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Neon (Lakebase Postgres). Use the pooled host (-pooler) at runtime.
# Direct (unpooled) URL is for migrations only.
# Leave both empty to use local SQLite for a quick demo.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# AWS S3 (required in serverless; optional locally)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=
# public | private  — workshop images should be publicly readable
AWS_S3_DEFAULT_ACL=public-read

# Razorpay Payment Links
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Preferred name for the bookings.healthyome.in webhook (same value as above).
RAZORPAY_WEBHOOK_SECRET_TIRAMISU=
# true = skip live Razorpay calls; show a local "Pay now" confirm step
# Production uses false so guests go to the Event’s rzp.io link (or a unique API link).
RAZORPAY_MOCK=true

# WhatsApp (VertexCRM / AI Sensy). Leave URL empty to log messages only.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# JSON object merged into every send payload, if the provider needs extra keys
WHATSAPP_EXTRA_PAYLOAD={}

# Vercel Cron → GET /cron/reminders (Authorization: Bearer <CRON_SECRET> or ?secret=)
CRON_SECRET=

# Public site URL used for Razorpay callbacks and webhook docs
# Production: https://bookings.healthyome.in
PUBLIC_BASE_URL=http://127.0.0.1:8000
# DJANGO_ALLOWED_HOSTS=bookings.healthyome.in,.vercel.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://bookings.healthyome.in,https://*.vercel.app

# Email after payment (WhatsApp group invite). Leave unset to log only —
# payment still succeeds. Local settings use the console backend.
#
# Zoho Mail / Zoho Workplace — implicit SSL on 465 (production path):
#   EMAIL_HOST=smtppro.zoho.com
#   EMAIL_PORT=465
#   EMAIL_USE_SSL=true
#   EMAIL_USE_TLS=false
#   EMAIL_HOST_USER=you@yourdomain.com
#   DEFAULT_FROM_EMAIL=Cafe Orelo <you@yourdomain.com>
# Use smtppro.zoho.com (not smtp.zoho.com) for a custom domain mailbox.
# From address must be that mailbox (or an allowed alias).
# EMAIL_HOST_PASSWORD is a Zoho *app password*, not the mailbox login.
# Set the password only in local .env or Vercel → Sensitive. Never commit it.
#
# STARTTLS alternative (port 587): EMAIL_USE_SSL=false EMAIL_USE_TLS=true
# Resend SMTP: EMAIL_HOST=smtp.resend.com EMAIL_PORT=587 EMAIL_HOST_USER=resend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Cafe Orelo <info@healthyome.in>
# Optional HTTP mail (Resend-style) if Vercel blocks outbound SMTP 465.
# EMAIL_HTTP_URL=https://api.resend.com/emails
# EMAIL_HTTP_TOKEN=
