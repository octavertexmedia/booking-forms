# Django
DJANGO_SETTINGS_MODULE=portal.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
WAGTAILADMIN_BASE_URL=http://127.0.0.1:8000

# Superuser created by: python manage.py bootstrap_workshop
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Neon (Lakebase Postgres). Use the pooled host (-pooler) at runtime.
# Direct (unpooled) URL is for migrations only.
# Leave both empty to use local SQLite for a quick demo.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# AWS S3 (required in serverless; optional locally)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=
# public | private  — workshop images should be publicly readable
AWS_S3_DEFAULT_ACL=public-read

# Razorpay Payment Links
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# true = skip live Razorpay calls; show a local "Pay now" confirm step
RAZORPAY_MOCK=true

# WhatsApp (VertexCRM / AI Sensy). Leave URL empty to log messages only.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# JSON object merged into every send payload, if the provider needs extra keys
WHATSAPP_EXTRA_PAYLOAD={}

# Public site URL used for Razorpay callbacks and webhook docs
PUBLIC_BASE_URL=http://127.0.0.1:8000
